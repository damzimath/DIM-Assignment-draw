    <mxGraphModel dx="2519" dy="1587" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;theme&#39;: &#39;base&#39;, &#39;flowchart&#39;: {&#39;curve&#39;: &#39;linear&#39;}}}%%\nerDiagram\n    %% --------------------------------------------------------\n    %% SUPERCLASS: CUSTOMER\n    %% --------------------------------------------------------\n    CUSTOMER {\n        string CustomerID PK\n        date RegistrationDate PK\n        string FullName\n        string ContactNumber\n        string EmailAddress\n        string PreferredLanguage\n        string EthnicGroup\n        string HouseholdIncomeRange\n        string Profession\n        string ActiveStatus\n    }\n\n    INDIVIDUAL_CUSTOMER {\n        string CustomerID PK\n        date RegistrationDate PK\n        string MyKadNumber\n        string Gender\n        date DateOfBirth\n        int SpouseCount\n        int KidsCount\n        int TeensCount\n        int ParentsCount\n        int GrandparentsCount\n    }\n\n    CORPORATE_CUSTOMER {\n        string CustomerID PK\n        date RegistrationDate PK\n        string CompanyRegNumber\n        string CompanyName\n        string IndustryType\n        string TaxIdentificationNo\n        int TotalEmployees\n        decimal AnnualRevenue\n        string ContactPersonName\n        string ContactPersonRole\n    }\n\n    %% --------------------------------------------------------\n    %% SUPERCLASS: EQUIPMENT\n    %% --------------------------------------------------------\n    EQUIPMENT {\n        string SerialNumber PK\n        string BatchCode PK\n        string ModelName\n        string BrandName\n        date ManufactureDate\n        int WarrantyPeriodMonths\n        string EquipmentCondition\n        decimal ProcurementCost\n        string FirmwareVersion\n        string QualityCheckStatus\n    }\n\n    SET_TOP_BOX {\n        string SerialNumber PK\n        string BatchCode PK\n        string BoxType\n        string ViewingOption\n        int HardDriveCapacityGB\n        string ResolutionSupported\n        string BluetoothEnabled\n        string WifiMACAddress\n        string EthernetMACAddress\n        string PowerSupplyRating\n    }\n\n    SMARTCARD {\n        string SerialNumber PK\n        string BatchCode PK\n        string ChipVersion\n        string EncryptionKey\n        date IssueDate\n        date ExpiryDate\n        string PairedStatus\n        string RegionalCode\n        int StorageCapacityKB\n        string ManufacturerID\n    }\n\n    %% --------------------------------------------------------\n    %% CORE ENTITIES\n    %% --------------------------------------------------------\n    ACCOUNT {\n        string AccountNumber PK\n        date CreationDate PK\n        decimal OutstandingBalance\n        string BillingFrequency\n        string PreferredBillingMode\n        string MarketingConsentStatus\n        string AutoDebitStatus\n        int ContractDurationMonths\n        string AccountMergeStatus\n        string AccountSplitStatus\n    }\n\n    INSTALLATION_ADDRESS {\n        string AddressID PK\n        string PostalCode PK\n        string ComplexName\n        string BlockName\n        string FloorSuiteNo\n        string HouseNo\n        string StreetName\n        string Area\n        string CityTown\n        string State\n    }\n\n    ALTERNATIVE_CONTACT {\n        string ContactID PK\n        date CreatedDate PK\n        string ContactFullName\n        string Relationship\n        string HomePhone\n        string OfficePhone\n        string MobilePhone\n        string Extension\n        string PrimaryContactSync\n        string AvailabilityHours\n    }\n\n    COMMUNICATION_LOG {\n        string LogID PK\n        timestamp SendTimestamp PK\n        string ChannelType\n        string CampaignName\n        string DeliveryStatus\n        decimal OpenRate\n        decimal ClickRate\n        string BounceReason\n        string ReadReceipt\n        decimal CostPerMessage\n    }\n\n    %% --------------------------------------------------------\n    %% BILLING &amp; PAYMENTS\n    %% --------------------------------------------------------\n    BILLING_INVOICE {\n        string InvoiceNumber PK\n        date InvoiceDate PK\n        decimal InvoiceAmount\n        decimal TaxAmount\n        decimal DiscountAmount\n        date DueDate\n        string PaymentStatus\n        decimal PenaltyFee\n        date BillingPeriodStart\n        date BillingPeriodEnd\n    }\n\n    PAYMENT_TRANSACTION {\n        string TransactionID PK\n        timestamp TransactionDate PK\n        string PaymentMethod\n        decimal PaymentAmount\n        string BankName\n        string AuthorizationCode\n        string ReceiptNumber\n        string Currency\n        string GatewayStatus\n        string RefundStatus\n    }\n\n    CREDIT_CARD_DETAIL {\n        string CardNumberHash PK\n        date ExpiryDate PK\n        string IssuingBank\n        string CardholderName\n        string CardType\n        string AutoDebitEnabled\n        string LastFourDigits\n        string TokenID\n        string ValidationStatus\n        decimal MaxLimit\n    }\n\n    %% --------------------------------------------------------\n    %% PACKAGES &amp; SERVICES\n    %% --------------------------------------------------------\n    SUBSCRIPTION_PACKAGE {\n        string PackageCode PK\n        date LaunchDate PK\n        string PackageName\n        decimal MonthlyFee\n        int BaseChannelCount\n        int HDChannelCount\n        int UHDChannelCount\n        string Description\n        string PromotionEligibility\n        string PackageStatus\n    }\n\n    ADD_ON_CHANNEL {\n        string AddOnCode PK\n        date ActivationDate PK\n        string CategoryName\n        decimal MonthlyRate\n        int MinimumCommitmentDays\n        string LanguageTrack\n        string SubtitleOption\n        int TrialPeriodDays\n        string Genre\n        string TargetAudience\n    }\n\n    MULTIROOM_SUBSCRIPTION {\n        string MultiroomID PK\n        date SetupDate PK\n        decimal MonthlyCharge\n        string BoxRequirement\n        string ViewingOption\n        decimal ActivationFee\n        string DiscountApplicable\n        int MaxDevices\n        string ContentMirroringStatus\n        string HDEnabled\n    }\n\n    CLOUD_SERVICE {\n        string CloudPlanID PK\n        date ReleaseDate PK\n        int StorageHours\n        decimal UpgradeFee\n        int BandwidthLimitGB\n        int RetentionDays\n        string AutoDeletePolicy\n        string SyncStatus\n        string ResolutionSupport\n        string ServerRegion\n    }\n\n    %% --------------------------------------------------------\n    %% OPERATIONS &amp; LOGISTICS\n    %% --------------------------------------------------------\n    SERVICE_REQUEST_FORM {\n        string RequestID PK\n        date SubmissionDate PK\n        string RequestType\n        string RequestReason\n        string ApprovalStatus\n        string ProcessedByAdmin\n        date CompletionDate\n        string SystemRemarks\n        string CustomerSignatureStatus\n        string SupportingDocProvided\n    }\n\n    INSTALLATION_APPOINTMENT {\n        string AppointmentID PK\n        date ScheduledDate PK\n        string TimeSlot\n        string AssignmentStatus\n        string PropertyType\n        string ComplexityLevel\n        int EstimatedDurationMins\n        string CustomerRemarks\n        time CompletionTime\n        int SatisfactionScore\n    }\n\n    INSTALLER_TECHNICIAN {\n        string TechnicianID PK\n        date HireDate PK\n        string FirstName\n        string LastName\n        string PhoneNumber\n        string VehiclePlate\n        string SkillLevel\n        string ActiveStatus\n        string BranchLocation\n        int TotalCompletedJobs\n    }\n\n    %% --------------------------------------------------------\n    %% RELATIONSHIPS (Straight Connection Rules Mapped)\n    %% --------------------------------------------------------\n    \n    CUSTOMER ||--o| INDIVIDUAL_CUSTOMER : \&quot;is\&quot;\n    CUSTOMER ||--o| CORPORATE_CUSTOMER : \&quot;is\&quot;\n    EQUIPMENT ||--o| SET_TOP_BOX : \&quot;is\&quot;\n    EQUIPMENT ||--o| SMARTCARD : \&quot;is\&quot;\n    CUSTOMER ||--o{ ACCOUNT : \&quot;owns\&quot;\n    CUSTOMER ||--o{ COMMUNICATION_LOG : \&quot;receives\&quot;\n    CUSTOMER ||--o{ ALTERNATIVE_CONTACT : \&quot;provides\&quot;\n    ACCOUNT ||--o{ INSTALLATION_ADDRESS : \&quot;registers\&quot;\n    ACCOUNT ||--|{ BILLING_INVOICE : \&quot;generates\&quot;\n    ACCOUNT ||--o{ CREDIT_CARD_DETAIL : \&quot;uses\&quot;\n    ACCOUNT ||--o{ SERVICE_REQUEST_FORM : \&quot;submits\&quot;\n    ACCOUNT ||--|{ SUBSCRIPTION_PACKAGE : \&quot;subscribes\&quot;\n    ACCOUNT ||--|{ EQUIPMENT : \&quot;leases\&quot;\n    BILLING_INVOICE ||--o{ PAYMENT_TRANSACTION : \&quot;settled\&quot;\n    SUBSCRIPTION_PACKAGE ||--o{ ADD_ON_CHANNEL : \&quot;includes\&quot;\n    SUBSCRIPTION_PACKAGE ||--o{ MULTIROOM_SUBSCRIPTION : \&quot;enables\&quot;\n    SUBSCRIPTION_PACKAGE ||--o{ CLOUD_SERVICE : \&quot;features\&quot;\n    SERVICE_REQUEST_FORM ||--o| INSTALLATION_APPOINTMENT : \&quot;triggers\&quot;\n    INSTALLATION_APPOINTMENT }o--|| INSTALLATION_ADDRESS : \&quot;at\&quot;\n    INSTALLER_TECHNICIAN ||--o{ INSTALLATION_APPOINTMENT : \&quot;assigned\&quot;&quot;&#xa;}" id="2">
